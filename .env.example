DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/voyage?sslaccept=strict
NODE_ENV=development
APP_NAME=Voyage by CrewCheck
APP_URL=https://crewcheck.online/voyage

# Server-only secret, minimum 32 characters. Generate a unique random value per environment.
SESSION_SIGNING_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_AUDIENCE=

# Prefer CrewCheck shared services when available.
CREWCHECK_SHARED_API_BASE_URL=
CREWCHECK_SHARED_SERVICES_TOKEN=

# Direct provider fallback. Keep server-side only; never expose to browser code.
AWESOMEAPI_API_KEY=

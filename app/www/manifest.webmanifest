{
  "name": "Voyage by CrewCheck",
  "short_name": "Voyage",
  "description": "Planeje. Viaje. Compartilhe. Viva mais.",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#07111c",
  "theme_color": "#08131f",
  "orientation": "portrait-primary",
  "categories": ["travel", "lifestyle"],
  "share_target": {
    "action": "./share-pdf",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "pdf",
          "accept": ["application/pdf", ".pdf"]
        }
      ]
    }
  }
}
